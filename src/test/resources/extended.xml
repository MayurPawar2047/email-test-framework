<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Slow / network-dependent checks, e.g. link reachability: mvn test "-Dsuite=extended.xml" -->
<suite name="Email Extended Suite">
    <listeners>
        <listener class-name="com.qa.email.reporting.TestListener"/>
    </listeners>
    <test name="Extended">
        <groups><run><include name="extended"/></run></groups>
        <packages><package name="com.qa.email.tests"/></packages>
    </test>
</suite>
