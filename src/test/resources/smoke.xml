<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Fast gate: mvn test -Dsuite=smoke.xml -->
<suite name="Email Smoke Suite">
    <listeners>
        <listener class-name="com.qa.email.reporting.TestListener"/>
    </listeners>
    <test name="Smoke">
        <groups><run><include name="smoke"/></run></groups>
        <packages><package name="com.qa.email.tests"/></packages>
    </test>
</suite>
