<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full suite: offline unit tests + integration tests (run in parallel).
     Slow / network-dependent checks (group "extended") are excluded; run them with:
     mvn test "-Dsuite=extended.xml" -->
<suite name="Email Automation Suite" parallel="classes" thread-count="3">
    <listeners>
        <listener class-name="com.qa.email.reporting.TestListener"/>
    </listeners>

    <test name="Unit">
        <groups><run><include name="unit"/></run></groups>
        <packages><package name="com.qa.email.unit"/></packages>
    </test>

    <test name="Integration">
        <groups>
            <run>
                <include name="integration"/>
                <exclude name="extended"/>
            </run>
        </groups>
        <packages><package name="com.qa.email.tests"/></packages>
    </test>
</suite>
